# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing session tokens (set a strong random string in production)
SESSION_SECRET="change-me-in-production"

# LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET: Optional LiveKit WebRTC SFU server credentials.
# When omitted, Family Connect uses built-in authenticated peer-to-peer WebRTC signaling over WebSockets.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
