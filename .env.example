# APP_URL: The URL where this applet is hosted (e.g. https://family.yourdomain.com)
APP_URL="https://royal-darkcyan-scorpion-53.hostingersite.com"

# SESSION_SECRET: Secret key for signing session tokens (set a strong random string in production)
SESSION_SECRET="change-me-to-a-random-64-character-secret"

# NODE_ENV: Set to production on live hosting
NODE_ENV="production"

